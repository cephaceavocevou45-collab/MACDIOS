ENVIRONMENT=development
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gestion_commerce
# Optionnel en production. Sans Redis, le cache partagé utilise PostgreSQL
# (table nobi_cache) et augmente la charge de la base.
REDIS_URL=
# Sauvegarde S3 optionnelle. Sans ces deux valeurs, aucune sauvegarde distante
# n'est assurée et la commande échoue clairement en production.
BACKUP_ENCRYPTION_KEY=
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=nobi/database
AWS_REGION=
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
FRONTEND_URL=http://localhost:5173
PUBLIC_FRONTEND_URL=http://localhost:5173
# Pour le lancement local sans Docker, renseignez ces numéros dans backend/.env.
# Docker Compose lit le fichier .env à la racine du projet.
NUMERO_MTN=
NUMERO_MOOV=
NUMERO_CELTIIS=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SENTRY_DSN=
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
CSRF_TRUSTED_ORIGINS=
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=Lax
LOG_LEVEL=INFO

# Vonage SMS. Garder la simulation activée jusqu'à la configuration d'un vrai compte.
SMS_SIMULATION=True
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_SMS_SENDER=Nobi

# Brevo emails transactionnels : la simulation évite les appels réels en développement.
EMAIL_SIMULATION=True
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Nobi
