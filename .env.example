# Configuration locale Docker Compose — remplacez ces valeurs avant tout déploiement.
SECRET_KEY=cle-locale-a-remplacer-avant-deploiement
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
FRONTEND_URL=http://localhost:8080
PUBLIC_FRONTEND_URL=http://localhost:8080
# Numéros Mobile Money du propriétaire, lus par Docker Compose depuis le .env racine.
# Un opérateur vide n'apparaît pas sur la page Abonnement.
NUMERO_MTN=
NUMERO_MOOV=
NUMERO_CELTIIS=
VITE_API_URL=http://localhost:8000
SENTRY_DSN=
VITE_SENTRY_DSN=
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
CSRF_TRUSTED_ORIGINS=
LOG_LEVEL=INFO

# Vonage SMS. La simulation empêche tout appel payant en développement.
SMS_SIMULATION=True
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_SMS_SENDER=Nobi

# Brevo emails transactionnels. EMAIL_SIMULATION=False seulement après validation du compte.
EMAIL_SIMULATION=True
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Nobi

# PostgreSQL utilisé par Docker Compose : gardez les trois valeurs cohérentes.
DATABASE_URL=postgresql://nobi:mot-de-passe-local-a-remplacer@db:5432/nobi
POSTGRES_DB=nobi
POSTGRES_USER=nobi
POSTGRES_PASSWORD=mot-de-passe-local-a-remplacer

# Cloudinary : compte et environnement séparés recommandés pour dev et production.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
