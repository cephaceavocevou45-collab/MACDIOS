# Configuration locale Docker Compose — remplacez ces valeurs avant tout déploiement.
SECRET_KEY=
ENVIRONMENT=
DEBUG=
ALLOWED_HOSTS=
CORS_ALLOWED_ORIGINS=
FRONTEND_URL=
PUBLIC_FRONTEND_URL=
# Numéros Mobile Money du propriétaire, lus par Docker Compose depuis le .env racine.
# Un opérateur vide n'apparaît pas sur la page Abonnement.
NUMERO_MTN=
NUMERO_MOOV=
NUMERO_CELTIIS=
VITE_API_URL=
SENTRY_DSN=
VITE_SENTRY_DSN=
SECURE_SSL_REDIRECT=
SECURE_HSTS_SECONDS=
CSRF_TRUSTED_ORIGINS=
AUTH_COOKIE_SECURE=
AUTH_COOKIE_SAMESITE=
LOG_LEVEL=

# Vonage SMS. La simulation empêche tout appel payant en développement.
SMS_SIMULATION=
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_SMS_SENDER=

# Brevo emails transactionnels. EMAIL_SIMULATION=False seulement après validation du compte.
EMAIL_SIMULATION=
BREVO_API_KEY=
# expire le 30 Septembre 2027
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# PostgreSQL utilisé par Docker Compose : gardez les trois valeurs cohérentes.
DATABASE_URL=
# Optionnel en production. Sans Redis, le cache partagé utilise PostgreSQL
# (table nobi_cache) et augmente la charge de la base.
REDIS_URL=
# Sauvegarde S3 optionnelle. Laissez ces variables vides pour désactiver
# explicitement la sauvegarde distante ; aucun backup de production ne sera créé.
BACKUP_ENCRYPTION_KEY=
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=nobi/database
AWS_REGION=
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
